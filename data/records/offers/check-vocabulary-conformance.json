  "bodyExample": {
    "config": {
      "formatVersion": 1,
      "parse": {
        "rdf": {
          "glob": "onto/**/*.ttl",
          "minimum": 2
        }
      },
      "vocabulary": {
        "files": [
          "onto/vocab.ttl"
        ],
        "namespace": "https://example.org/v#",
        "declaredTermsAtLeast": 3,
        "ontology": {
          "iri": "https://example.org/v"
        }
      },
      "skos": {
        "scheme": "https://example.org/v#terms",
        "conceptCount": 2
      },
      "closedSets": [
        {
          "class": "https://example.org/v#Status",
          "size": 2
        }
      ],
      "records": {
        "glob": "data/*.json",
        "context": "onto/context.jsonld",
        "shapes": "onto/shapes.ttl",
        "baseIri": "https://example.org/record/",
        "unmappedPrefix": "https://example.org/field#",
        "kinds": {
          "data/a.json": "https://example.org/v#Doc"
        }
      },
      "shapeTests": [
        {
          "id": "unmodified-a",
          "record": "data/a.json",
          "mutation": [],
          "expect": "conforms",
          "reason": "The untouched record passes."
        },
        {
          "id": "negative-count",
          "record": "data/a.json",
          "mutation": [
            {
              "op": "replace",
              "path": "/count",
              "value": -1
            }
          ],
          "expect": "violates",
          "reason": "A count may not be negative."
        }
      ]
    },
    "files": {
      "onto/vocab.ttl": "@prefix : <https://example.org/v#> .\n@prefix h: <https://example.org/house/> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n@prefix prov: <http://www.w3.org/ns/prov#> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n\n<https://example.org/v> a owl:Ontology ; owl:versionInfo \"0.1.0\" .\n:Doc a owl:Class ; rdfs:label \"Doc\" ; rdfs:comment \"A document record.\" .\n:count a owl:DatatypeProperty ; rdfs:comment \"How many.\" .\n:Status a owl:Class ; rdfs:label \"Status\" ; owl:equivalentClass [ a owl:Class ; owl:oneOf ( :open :closed ) ] .\n:open a :Status ; skos:prefLabel \"open\" ; skos:definition \"Still under discussion.\" ; skos:inScheme :terms .\n:closed a :Status ; skos:prefLabel \"closed\" ; skos:definition \"No longer under discussion.\" ; skos:inScheme :terms .\n:terms a skos:ConceptScheme ; skos:hasTopConcept :open , :closed .\n:open a skos:Concept . :closed a skos:Concept .\n",
      "onto/context.jsonld": "{\n  \"@context\": {\n    \"@version\": 1.1,\n    \"@vocab\": \"https://example.org/field#\",\n    \"ex\": \"https://example.org/v#\",\n    \"xsd\": \"http://www.w3.org/2001/XMLSchema#\",\n    \"kind\": \"@type\",\n    \"Doc\": \"ex:Doc\",\n    \"Item\": \"ex:Item\",\n    \"count\": {\n      \"@id\": \"ex:count\",\n      \"@type\": \"xsd:integer\"\n    },\n    \"items\": \"ex:hasItem\"\n  }\n}",
      "onto/shapes.ttl": "@prefix : <https://example.org/v#> .\n@prefix h: <https://example.org/house/> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n@prefix prov: <http://www.w3.org/ns/prov#> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n\n<https://example.org/shapes/DocShape> a sh:NodeShape ; sh:targetClass :Doc ;\n  sh:property [ sh:path :count ; sh:minCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] .\n",
      "data/a.json": "{\n  \"kind\": \"Doc\",\n  \"count\": 3\n}"
    }
  },
